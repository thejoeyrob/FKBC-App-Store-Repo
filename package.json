    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.10.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
